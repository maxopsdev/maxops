# Copy to .env and fill in before `docker compose up` (all optional — MaxOps
# starts fine with none of these set, you just won't get real AWS data until
# you provide credentials via the onboarding wizard or here).
#
# Settings are commented out on purpose. An assignment with nothing after the
# `=` does not mean "unset" — it defines the variable as an empty string, and
# for AWS_PROFILE that is worse than leaving it out: botocore reads it as a
# profile *named* empty and every AWS call fails with
# `ProfileNotFound: The config profile () could not be found`.
# Uncomment only the lines you actually set.

# AWS credentials — pick ONE option, or configure entirely from the onboarding UI.

# Option 1: local AWS CLI profile. Also set AWS_CONFIG_HOST_DIR below so the
# container can actually read your ~/.aws files.
# AWS_PROFILE=my-profile

# Option 2: access keys (works on all platforms, no extra mount needed)
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# Required for Option 1: point this at your local AWS config directory so
# docker-compose.yml can mount it read-only into the backend container.
# macOS/Linux:            AWS_CONFIG_HOST_DIR=/Users/you/.aws
# Windows (PowerShell):   AWS_CONFIG_HOST_DIR=C:/Users/you/.aws
# Omit it entirely to skip — an empty placeholder is mounted instead so
# `docker compose up` still works fine without AWS_PROFILE.
# AWS_CONFIG_HOST_DIR=/Users/you/.aws

# IAM Identity Center (SSO) only. The ~/.aws mount is read-only by default so
# MaxOps can never rewrite your real AWS config. botocore renews a cached SSO
# token in place, which a read-only mount blocks, so SSO users set this to rw.
# Run `aws sso login --profile <name>` on this machine first — there is no
# browser inside the container.
# AWS_CONFIG_MOUNT_MODE=rw

AWS_REGION=us-east-1

# Global gate for REAL (non-test) AWS actions: stop/terminate/delete/modify.
# Leave false until you're ready — see the root README's security note.
MAXOPS_ENABLE_ACTIONS=false
