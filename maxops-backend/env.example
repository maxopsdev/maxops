# MaxOps Backend Environment Variables
# Copy this file to .env and update with your actual values.
# Only variables actually read by app/config.py are listed here — anything else
# in an old .env is silently ignored by the app (pydantic-settings `extra = "ignore"`).

# Application
APP_NAME=MaxOps API
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./maxops.db
PRICING_DATABASE_PATH=./maxops_pricing.db

# AWS Credentials — pick ONE option
# Option 1: AWS CLI profile (recommended for local use)
# Uncomment and set to a profile that exists in your ~/.aws/config.
# Naming a profile that is not there fails every AWS call; leaving this
# commented out means no profile, which is what you want with access keys
# or the onboarding wizard.
# AWS_PROFILE=my-profile

# Option 2: Access keys (not recommended for anything beyond quick local testing)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Option 3: IAM role (for EC2/ECS deployment of the backend itself)
# AWS_USE_IAM_ROLE=true
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/MaxOpsRole
# AWS_ROLE_SESSION_NAME=maxops-backend

AWS_REGION=us-east-1

# Feature flags
# Enable the UI's "test action" affordance (safe/no-op actions). Off by default.
TEST_ACTION=false
# Global gate for REAL (non-test) AWS actions: stop/terminate/delete/modify.
# Nothing destructive can run until this is true, even if a check/action is
# individually enabled in Settings. Off by default — opt in deliberately.
MAXOPS_ENABLE_ACTIONS=false

# Browser origins allowed to call the API, comma-separated. The default covers
# localhost and 127.0.0.1 on ports 3000 (Docker) and 5173 (vite dev). Set this
# when serving the UI from another hostname or behind a reverse proxy --
# otherwise the browser blocks every request and the UI shows "Network Error".
# MAXOPS_CORS_ORIGINS=https://maxops.internal.example

# Cost Data Settings (optional; only used if you wire up Cost & Usage Reports)
COST_EXPLORER_LOOKBACK_DAYS=90

# --- Cost data (optional) --------------------------------------------------
# MaxOps prices findings from public list prices by default. Connect an AWS
# Cost and Usage Report and it prices them from what resources actually cost,
# including Reserved Instance and Savings Plan discounts.
# Set this up from the Cost Data page in the app; these only override the
# choices made there.

# Price findings from the CUR cache instead of list prices. The choice made in
# the app takes precedence over this.
MAXOPS_CUR_PRICING_ENABLED=false
# Where summarised billing data is cached.
MAXOPS_CUR_CACHE_ROOT=data/cur_cache
# AWS profile used only for privileged cost-data setup, never for scanning.
MAXOPS_SETUP_AWS_PROFILE=
# Only needed to use a CUR bucket MaxOps did not create. Left empty, MaxOps
# uses maxops-cur-report-<account id>.
MAXOPS_CUR_BUCKET_ARN=
