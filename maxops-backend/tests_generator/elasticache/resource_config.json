{
  "service": "elasticache",
  "profile": "default",
  "region": "us-east-1",
  "state_file": "tests_generator/elasticache/.elasticache_capture_state.json",
  "placeholder_values": {
    "ACCOUNT_ID": "123456789012",
    "REGION": "us-east-1",
    "LOW_ITEMS_CLUSTER_ID": "maxops-payload-elasticache-low-items",
    "NON_GRAVITON_CLUSTER_ID": "maxops-payload-elasticache-non-graviton",
    "REDIS_VALKEY_RG_ID": "maxops-payload-elasticache-redis-valkey",
    "INELIGIBLE_REDIS_RG_ID": "maxops-payload-elasticache-redis-ineligible"
  },
  "capture_window_days": 7,
  "cache_cluster_definitions": {
    "low_items_graviton_cluster": {
      "identifier_placeholder_key": "LOW_ITEMS_CLUSTER_ID",
      "cache_node_type": "cache.t4g.micro",
      "engine": "redis",
      "num_cache_nodes": 1,
      "tags": {
        "Name": "{{LOW_ITEMS_CLUSTER_ID}}",
        "maxops_test": "true",
        "maxops_payload_capture": "true",
        "maxops_payload_profile": "low_items_graviton_cluster"
      }
    },
    "non_graviton_cluster": {
      "identifier_placeholder_key": "NON_GRAVITON_CLUSTER_ID",
      "cache_node_type": "cache.t3.micro",
      "engine": "redis",
      "num_cache_nodes": 1,
      "tags": {
        "Name": "{{NON_GRAVITON_CLUSTER_ID}}",
        "maxops_test": "true",
        "maxops_payload_capture": "true",
        "maxops_payload_profile": "non_graviton_cluster"
      }
    }
  },
  "replication_group_definitions": {
    "redis_replication_group": {
      "identifier_placeholder_key": "REDIS_VALKEY_RG_ID",
      "cache_node_type": "cache.t4g.micro",
      "engine": "redis",
      "engine_version": "6.2",
      "num_cache_clusters": 2,
      "automatic_failover_enabled": false,
      "tags": {
        "Name": "{{REDIS_VALKEY_RG_ID}}",
        "maxops_test": "true",
        "maxops_payload_capture": "true",
        "maxops_payload_profile": "redis_replication_group"
      }
    },
    "ineligible_redis_replication_group": {
      "identifier_placeholder_key": "INELIGIBLE_REDIS_RG_ID",
      "cache_node_type": "cache.t4g.micro",
      "engine": "redis",
      "engine_version": "5.0.6",
      "num_cache_clusters": 2,
      "automatic_failover_enabled": false,
      "tags": {
        "Name": "{{INELIGIBLE_REDIS_RG_ID}}",
        "maxops_test": "true",
        "maxops_payload_capture": "true",
        "maxops_payload_profile": "ineligible_redis_replication_group"
      }
    }
  }
}
