        "maxops_payload_capture": "true",
        "maxops_payload_profile": "versioned_missing_noncurrent_controls"
      },
      "lifecycle_configuration": {
        "Rules": [
          {
            "ID": "current-only-controls",
            "Status": "Enabled",
            "Filter": {
              "Prefix": ""
            },
            "Expiration": {
              "Days": 60
            },
            "Transitions": [
              {
                "Days": 30,
                "StorageClass": "GLACIER"
              }
            ],
            "AbortIncompleteMultipartUpload": {
              "DaysAfterInitiation": 7
            }
          }
        ]
      }
    },
