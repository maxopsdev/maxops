{
  "profile": "maxops",
  "region": "us-east-1",
  "state_file": "tests_generator/s3/.s3_capture_state.json",
  "placeholder_values": {
    "ACCOUNT_ID": "123456789012",
    "REPLICATION_ROLE_NAME": "maxops-payload-s3-replication-role",
    "REPLICATION_POLICY_NAME": "maxops-payload-s3-replication-policy",
    "PLAIN_NO_LIFECYCLE_BUCKET": "maxops-payload-s3-plain-no-lifecycle",
    "LIFECYCLE_NO_EXPIRATION_BUCKET": "maxops-payload-s3-lifecycle-no-expiration",
    "LIFECYCLE_NO_ARCHIVAL_BUCKET": "maxops-payload-s3-lifecycle-no-archival",
    "LIFECYCLE_NO_MPU_BUCKET": "maxops-payload-s3-lifecycle-no-mpu",
    "VERSIONED_MISSING_NONCURRENT_BUCKET": "maxops-payload-s3-versioned-missing-noncurrent",
    "COMPLIANT_NONVERSIONED_BUCKET": "maxops-payload-s3-compliant-nonversioned",
    "COMPLIANT_VERSIONED_BUCKET": "maxops-payload-s3-compliant-versioned",
    "LOGGING_SOURCE_BUCKET": "maxops-payload-s3-logging-source",
    "LOGGING_TARGET_BUCKET": "maxops-payload-s3-logging-target",
    "INVENTORY_SOURCE_BUCKET": "maxops-payload-s3-inventory-source",
    "INVENTORY_DEST_BUCKET": "maxops-payload-s3-inventory-dest",
    "REPLICATION_SOURCE_BUCKET": "maxops-payload-s3-replication-source",
    "REPLICATION_DEST_BUCKET": "maxops-payload-s3-replication-dest"
  },
  "bucket_definitions": {
    "plain_no_lifecycle": {
      "name_placeholder_key": "PLAIN_NO_LIFECYCLE_BUCKET",
      "versioning": false,
      "tags": {
        "Name": "{{PLAIN_NO_LIFECYCLE_BUCKET}}",
        "maxops_payload_capture": "true",
        "maxops_payload_profile": "plain_no_lifecycle"
      }
    },
    "lifecycle_no_expiration": {
      "name_placeholder_key": "LIFECYCLE_NO_EXPIRATION_BUCKET",
      "versioning": false,
      "tags": {
        "Name": "{{LIFECYCLE_NO_EXPIRATION_BUCKET}}",
        "maxops_payload_capture": "true",
        "maxops_payload_profile": "lifecycle_no_expiration"
      },
      "lifecycle_configuration": {
        "Rules": [
          {
            "ID": "archive-no-expiration",
            "Status": "Enabled",
            "Filter": {
              "Prefix": ""
            },
            "Transitions": [
              {
                "Days": 30,
                "StorageClass": "GLACIER"
              }
            ],
            "AbortIncompleteMultipartUpload": {
              "DaysAfterInitiation": 7
            }
          }
        ]
      }
    },
    "lifecycle_no_archival": {
      "name_placeholder_key": "LIFECYCLE_NO_ARCHIVAL_BUCKET",
      "versioning": false,
      "tags": {
        "Name": "{{LIFECYCLE_NO_ARCHIVAL_BUCKET}}",
        "maxops_payload_capture": "true",
        "maxops_payload_profile": "lifecycle_no_archival"
      },
      "lifecycle_configuration": {
        "Rules": [
          {
            "ID": "expire-no-archive",
            "Status": "Enabled",
            "Filter": {
              "Prefix": ""
            },
            "Expiration": {
              "Days": 60
            },
            "AbortIncompleteMultipartUpload": {
              "DaysAfterInitiation": 7
            }
          }
        ]
      }
    },
    "lifecycle_no_mpu": {
      "name_placeholder_key": "LIFECYCLE_NO_MPU_BUCKET",
      "versioning": false,
      "tags": {
        "Name": "{{LIFECYCLE_NO_MPU_BUCKET}}",
        "maxops_payload_capture": "true",
        "maxops_payload_profile": "lifecycle_no_mpu"
      },
      "lifecycle_configuration": {
        "Rules": [
          {
            "ID": "expire-and-archive-no-mpu",
            "Status": "Enabled",
            "Filter": {
              "Prefix": ""
            },
            "Expiration": {
              "Days": 60
            },
            "Transitions": [
              {
                "Days": 30,
                "StorageClass": "GLACIER"
              }
            ]
          }
        ]
      }
    },
    "versioned_missing_noncurrent_controls": {
      "name_placeholder_key": "VERSIONED_MISSING_NONCURRENT_BUCKET",
