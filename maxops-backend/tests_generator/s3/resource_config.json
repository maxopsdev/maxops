      "name_placeholder_key": "COMPLIANT_NONVERSIONED_BUCKET",
      "versioning": false,
      "tags": {
        "Name": "{{COMPLIANT_NONVERSIONED_BUCKET}}",
        "maxops_payload_capture": "true",
        "maxops_payload_profile": "compliant_nonversioned"
      },
      "lifecycle_configuration": {
        "Rules": [
          {
            "ID": "fully-managed-current",
            "Status": "Enabled",
            "Filter": {
              "Prefix": ""
            },
            "Expiration": {
              "Days": 60
            },
            "Transitions": [
              {
                "Days": 30,
                "StorageClass": "GLACIER"
              }
            ],
            "AbortIncompleteMultipartUpload": {
              "DaysAfterInitiation": 7
            }
          }
        ]
      }
    },
    "compliant_versioned": {
      "name_placeholder_key": "COMPLIANT_VERSIONED_BUCKET",
      "versioning": true,
      "tags": {
        "Name": "{{COMPLIANT_VERSIONED_BUCKET}}",
        "maxops_payload_capture": "true",
        "maxops_payload_profile": "compliant_versioned"
      },
      "lifecycle_configuration": {
        "Rules": [
          {
            "ID": "fully-managed-versioned",
            "Status": "Enabled",
            "Filter": {
              "Prefix": ""
            },
            "Expiration": {
              "Days": 60
            },
            "Transitions": [
              {
                "Days": 30,
                "StorageClass": "GLACIER"
              }
            ],
            "AbortIncompleteMultipartUpload": {
              "DaysAfterInitiation": 7
            },
            "NoncurrentVersionExpiration": {
              "NoncurrentDays": 60
            },
            "NoncurrentVersionTransitions": [
              {
                "NoncurrentDays": 30,
                "StorageClass": "GLACIER"
              }
            ]
          },
          {
            "ID": "delete-marker-cleanup",
            "Status": "Enabled",
            "Filter": {
              "Prefix": ""
            },
            "Expiration": {
              "ExpiredObjectDeleteMarker": true
            }
          }
        ]
      }
    },
