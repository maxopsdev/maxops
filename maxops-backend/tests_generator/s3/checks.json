{
  "s3_no_lifecycle_policy": {
    "scenarios": {
      "flag_bucket_without_lifecycle": {
        "description": "Use a bucket with no lifecycle configuration.",
        "capture_buckets": [
          "plain_no_lifecycle"
        ],
        "expected_matches": [
          "{{PLAIN_NO_LIFECYCLE_BUCKET}}"
        ],
        "check_parameters": {
          "region": "{{REGION}}"
        },
        "payload_files": [
          "list_buckets.json",
          "get_bucket_location__plain_no_lifecycle.json",
          "get_bucket_tagging__plain_no_lifecycle.json",
          "get_bucket_lifecycle_configuration__plain_no_lifecycle.json",
          "capture_metadata.json"
        ]
      },
      "pass_bucket_with_lifecycle": {
        "description": "Use a non-versioned bucket with a valid current-object lifecycle policy.",
        "capture_buckets": [
          "compliant_nonversioned"
        ],
        "expected_matches": [],
        "check_parameters": {
          "region": "{{REGION}}"
        },
        "payload_files": [
          "list_buckets.json",
          "get_bucket_location__compliant_nonversioned.json",
          "get_bucket_tagging__compliant_nonversioned.json",
          "get_bucket_lifecycle_configuration__compliant_nonversioned.json",
          "capture_metadata.json"
        ]
      }
    }
  },
