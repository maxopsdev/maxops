{
  "dynamodb_gsi_unused": {
    "scenarios": {
      "flag_unused_gsi": {
        "description": "Use the captured provisioned table GSI and synthesize zero read traffic.",
        "capture_tables": [
          "provisioned_capture"
        ],
        "capture_gsis": [
          "provisioned_capture:maxops_payload_unused_gsi"
        ],
        "expected_matches": [
          "{{PROVISIONED_TABLE_NAME}}/{{UNUSED_GSI_NAME}}"
        ],
        "check_parameters": {
          "lookback_days": 30,
          "period_seconds": 86400,
          "region": "{{REGION}}"
        },
        "metric_overrides": {
          "provisioned_capture:maxops_payload_unused_gsi": {
            "ConsumedReadCapacityUnits": {
              "Sum": 0.0
            },
            "ConsumedWriteCapacityUnits": {
              "Sum": 0.0
            }
          }
        },
        "payload_files": [
          "list_tables.json",
          "describe_table__provisioned_capture.json",
          "list_tags_of_resource__provisioned_capture.json",
          "get_metric_statistics__provisioned_capture__maxops_payload_unused_gsi__consumedreadcapacityunits.json",
          "get_metric_statistics__provisioned_capture__maxops_payload_unused_gsi__consumedwritecapacityunits.json",
          "capture_metadata.json"
        ]
      },
      "pass_gsi_with_reads": {
        "description": "Use the captured provisioned table GSI and synthesize positive read traffic.",
        "capture_tables": [
          "provisioned_capture"
        ],
        "capture_gsis": [
          "provisioned_capture:maxops_payload_unused_gsi"
        ],
        "expected_matches": [],
        "check_parameters": {
          "lookback_days": 30,
          "period_seconds": 86400,
          "region": "{{REGION}}"
        },
        "metric_overrides": {
          "provisioned_capture:maxops_payload_unused_gsi": {
            "ConsumedReadCapacityUnits": {
              "Sum": 4.0
            },
            "ConsumedWriteCapacityUnits": {
              "Sum": 0.0
            }
          }
        },
        "payload_files": [
          "list_tables.json",
          "describe_table__provisioned_capture.json",
          "get_metric_statistics__provisioned_capture__maxops_payload_unused_gsi__consumedreadcapacityunits.json",
          "get_metric_statistics__provisioned_capture__maxops_payload_unused_gsi__consumedwritecapacityunits.json",
          "capture_metadata.json"
        ]
      }
    }
  },
